# ==============================================================================
# 足迹 (Footprint) - 环境变量配置示例模板
# 复制本文件为 .env 即可生效：cp .env.example .env
# ==============================================================================

# ---------- 基础运行环境 ----------
# 运行环境：development（开发调试）或 production（生产环境）
FLASK_ENV=production

# 后端监听端口（默认 5000）
PORT=5000

# 跨域允许源，多个域名逗号分隔，例如：http://localhost:5000,https://myfootprint.com（开发环境默认推荐当前地址，生产环境务必填写正式域名，勿使用 *）
CORS_ORIGINS=http://localhost:5000

# 单个上传媒体文件体积上限 (单位: MB, 默认 50)
MEDIA_MAX_MB=50

# ---------- 用户认证与 JWT 安全 ----------
# JWT 签名密钥（留空时服务将自动在 data/.jwt_secret 生成 32 字节强随机密钥并持久化保存）
# 若使用集群或手动管理，请填写至少 32 位的强随机字符串
JWT_SECRET_KEY=

# 登录凭证有效期（单位: 小时，默认 24）
JWT_EXPIRY_HOURS=24

# ---------- 数据库配置 ----------
# 数据库类型：sqlite（默认）、postgres、json
DB_TYPE=sqlite

# SQLite 数据库文件路径（当 DB_TYPE=sqlite 时有效）
DB_NAME=data/footprint.db

# PostgreSQL 配置（当 DB_TYPE=postgres 时有效）
DB_HOST=localhost
DB_PORT=5432
DB_USER=footprint_user
DB_PASSWORD=your_secure_password

# ---------- 媒体文件存储配置 ----------
# 存储后端模式：local（本地目录存储，默认）、aliyun、tencent、qiniu、aws、gcp、azure
STORAGE_PROVIDER=local

# 1. 阿里云 OSS 配置 (当 STORAGE_PROVIDER=aliyun 时生效)
ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_BUCKET=
ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_DOMAIN=

# 2. 腾讯云 COS 配置 (当 STORAGE_PROVIDER=tencent 时生效)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_BUCKET=
TENCENT_REGION=ap-guangzhou
TENCENT_DOMAIN=

# 3. 七牛云 Kodo 配置 (当 STORAGE_PROVIDER=qiniu 时生效)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# 4. AWS S3 配置 (当 STORAGE_PROVIDER=aws 时生效)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_DOMAIN=

# 5. Google Cloud Storage (当 STORAGE_PROVIDER=gcp 时生效)
GCP_PROJECT_ID=
GCP_BUCKET=
GCP_CREDENTIALS=

# 6. Azure Blob Storage (当 STORAGE_PROVIDER=azure 时生效)
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=

# ---------- 地图服务与地理编码 ----------
# 高德地图 Web API Key（用于逆地理推断真实城市与打卡）
AMAP_KEY=

# 百度地图 API Key（可选）
BAIDU_MAP_KEY=

# 腾讯位置服务 API Key（可选）
TENCENT_MAP_KEY=

# 必应 Bing Maps Key（可选）
BING_MAP_KEY=

# ---------- AI 智能旅行故事 ----------
# OpenAI 或兼容协议大模型 API Key（用于基于足迹记录生成旅行游记文学故事）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 微信小程序对接 ----------
# 微信小程序 AppID 与 AppSecret（仅在使用配套小程序端时需要）
WECHAT_APPID=
WECHAT_SECRET=
