.album-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.title { font-size: 44rpx; font-weight: 800; }
.album-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.album-item { width: calc((100% - 24rpx) / 3); background: var(--bg-white); border-radius: 14rpx; overflow: hidden; }
.album-img { width: 100%; height: 210rpx; display: block; }
.album-caption { padding: 10rpx; font-size: 22rpx; color: var(--text-sec); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.empty { text-align: center; padding: 80rpx 24rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 12rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
