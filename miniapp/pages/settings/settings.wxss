.title { font-size: 44rpx; font-weight: 800; margin-bottom: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.mode-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.mode-row .btn { flex: 1; min-width: 180rpx; }
.data-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.data-num { color: var(--primary); font-size: 48rpx; font-weight: 800; }
.danger { color: #EF4444; border-color: rgba(239, 68, 68, .35); }
